<?xml version="1.0" encoding="UTF-8"?>
<OpenSearchDescription xmlns="http://a9.com/-/spec/opensearch/1.1/">
<ShortName>{{#if site.keys.opensearchShortName}}{{site.keys.opensearchShortName}}{{else}}{{site.title}}{{/if}}</ShortName>
<Description>{{site.title}}</Description>
<Url type="text/html" method="get" template="{{url-join site.url site.keys.searchPagePath}}?q={searchTerms}"/>
<Image width="16" height="16">{{url-join site.url '_/img/favicon-16x16.png'}}</Image>
<InputEncoding>UTF-8</InputEncoding>
<SearchForm>{{url-join site.url site.keys.searchPagePath}}</SearchForm>
</OpenSearchDescription>
