    {{! No Google Analytics: it sets cookies and sends visitor data to a third party, and none of
        these sites asks for consent. site.keys.googleAnalytics is ignored, Plausible replaces it. }}
    {{#with site.keys.plausibleScript}}
    {{! served from the site's own domain: its nginx proxies /js/<script> and /api/event to plausible.io }}
    <script async src="/js/{{this}}"></script>
    <script>window.plausible=window.plausible||function(){(plausible.q=plausible.q||[]).push(arguments)},plausible.init=plausible.init||function(i){plausible.o=i||{}};plausible.init({endpoint:'/api/event'})</script>
    {{/with}}
    <script>var uiRootPath = '{{{uiRootPath}}}'</script>
    {{#with site.keys.searchPagePath}}
    <script>var searchPagePath = '{{this}}'</script>
    {{/with}}
